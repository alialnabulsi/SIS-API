PORT=5000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sis_db
DB_USER=postgres
DB_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SIS_SERVICE_API_KEY=

# Optional local credential-verification rate limit settings:
# AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000

# Development seed safeguards (never enable in production):
# NODE_ENV=development
# DEV_SEED_CONFIRM=sis_db
# DEV_SEED_PASSWORD=

# Optional hosted-database settings:
# DATABASE_URL=
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
